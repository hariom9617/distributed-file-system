{
  "name": "storage-node",
  "version": "0.1.0",
  "description": "Milestone 1 — standalone chunk storage node",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
