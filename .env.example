# Unique identifier for this storage node.
# Use distinct values when running multiple nodes.
# Allowed characters: alphanumeric, hyphens, underscores (max 64 chars).
# Default: node-1
NODE_ID=node-1

# HTTP port the storage node listens on.
# Default: 3001
PORT=3001

# Absolute or relative path where chunk files are stored.
# Default: ./data/chunks
STORAGE_PATH=./data/chunks

# Log level: trace | debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=info
